# Server environment variables
# WARNING: Do not commit this file to source control. Use .env.example for sharing defaults.

# MongoDB connection (use your own URI if needed)
MONGO_URI=mongodb://localhost:27017/team_projects_db

# JWT secret - change this to a strong random value in production
JWT_SECRET=dev_secret_change_me

# Cookie name for auth token
COOKIE_NAME=token

# Enable open admin registration if true (use with caution)
ALLOW_ADMIN_REGISTRATION=true

# Server port
PORT=4000
